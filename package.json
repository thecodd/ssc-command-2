{
  "name": "cgl-command",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:study": "node tests/study/run.js",
    "audit:study": "node tests/study/audit.js",
    "validate:phase7": "node scripts/validate_phase7.mjs",
    "validate:sql-build": "node scripts/validate/sqlbuild.mjs",
    "validate:sql-check": "node scripts/validate/sqlbuild.mjs --check",
    "validate:static-sql": "node database/security/static_audit.cjs",
    "test:kit": "node --test --test-timeout=300000 tests/kit/kit.test.mjs tests/kit/ci.test.mjs tests/kit/e2e_harness.test.mjs tests/kit/contrast.test.mjs",
    "test:fixture-smoke": "node tests/browser/build.js && node tests/browser/gen.js && python3 tests/browser/run.py",
    "e2e:real": "node tests/e2e/real_routes.mjs",
    "lint:hooks": "node scripts/lint/hook_deps_check.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.13",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
